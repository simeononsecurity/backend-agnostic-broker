# Cache-aware pool routing example (ADR 0010 / ADR 0018).
# Copy to .env and set the real host URLs (kept OUT of git).

# Point the broker at this example registry.
BROKER_REGISTRY_PATH=examples/cache-aware-routing/registry.yaml
BROKER_ENABLED_BACKENDS=vllm

# --- Cache-aware routing ---
# Opt in to prefix-affinity + load-aware scoring for pools.
BROKER_ROUTE_STRATEGY=cache_aware
# β = cache-vs-load exchange rate. 0.5 is the ADR 0018 default (re-tuned under the
# queueing model); 0 = pure affinity (hot-spots under load), higher spreads harder.
BROKER_CACHE_AWARE_BETA=0.5
# ~4 chars/token; only full blocks are chain-hashed.
BROKER_CACHE_AWARE_BLOCK_CHARS=128
# Prefix-index LRU bound (shared across replicas under Redis) + residency TTL.
BROKER_CACHE_AWARE_MAX_ENTRIES=10000
BROKER_CACHE_AWARE_TTL_SECONDS=1800
# Optional: use the real vLLM queue-depth metric (vllm:num_requests_waiting) as the
# load signal, scraped by the NON-LOADING health probe. Falls back to in-flight counts.
BROKER_CACHE_AWARE_USE_METRICS=true

# --- Pool member hosts (placeholders; set real URLs in your .env) ---
VLLM_URL_1=http://127.0.0.1:8001
VLLM_URL_2=http://127.0.0.1:8002
VLLM_URL_3=http://127.0.0.1:8003

# Optional: share the prefix index across broker replicas.
# BROKER_REDIS_URL=redis://127.0.0.1:6379/0
