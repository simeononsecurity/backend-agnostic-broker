# Exact + semantic response cache (ADR 0012 + ADR 0014). Source before starting:
#   set -a && . ./examples/caching/env.semantic && set +a
BROKER_AUTH_ENABLED=true
BROKER_API_KEYS=["YOUR_API_KEY"]
BROKER_REGISTRY_PATH=examples/caching/registry.yaml
BROKER_ENABLED_BACKENDS=["fake"]

# --- exact cache (first layer) ---
BROKER_RESPONSE_CACHE_ENABLED=true
BROKER_RESPONSE_CACHE_TTL_SECONDS=300
BROKER_RESPONSE_CACHE_DETERMINISTIC_ONLY=true

# --- semantic cache (second layer, after an exact miss) ---
BROKER_SEMANTIC_CACHE_ENABLED=true
BROKER_SEMANTIC_CACHE_MODEL=echo-embed        # a registry alias served via /v1/embeddings
BROKER_SEMANTIC_CACHE_THRESHOLD=0.95          # precision-favoring; raise toward 0.99 to be stricter
BROKER_SEMANTIC_CACHE_TTL_SECONDS=300
BROKER_SEMANTIC_CACHE_MAX_ENTRIES=128
# Default true = never load the embedding model from a chat request (lazy-load
# invariant). Warm it first (an /v1/embeddings call or an admin preload), or set
# this false to allow on-demand loading.
BROKER_SEMANTIC_CACHE_REQUIRE_RESIDENT=true
