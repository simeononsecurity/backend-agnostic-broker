# Exact response cache only (ADR 0012). Source this before starting the broker:
#   set -a && . ./examples/caching/env.exact && set +a
BROKER_AUTH_ENABLED=true
BROKER_API_KEYS=["YOUR_API_KEY"]
BROKER_REGISTRY_PATH=examples/caching/registry.example.yaml
BROKER_ENABLED_BACKENDS=["fake"]

# --- exact cache ---
BROKER_RESPONSE_CACHE_ENABLED=true
BROKER_RESPONSE_CACHE_TTL_SECONDS=300
BROKER_RESPONSE_CACHE_DETERMINISTIC_ONLY=true
