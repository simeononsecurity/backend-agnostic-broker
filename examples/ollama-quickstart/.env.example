# Ollama quickstart — copy to .env (gitignored). Placeholders only.
#   set -a && . ./examples/ollama-quickstart/.env.example && set +a

BROKER_AUTH_ENABLED=true
BROKER_API_KEYS=["YOUR_API_KEY"]
BROKER_REGISTRY_PATH=examples/ollama-quickstart/registry.example.yaml

# Offline default: only the fake backend is enabled so this runs with no daemon.
BROKER_ENABLED_BACKENDS=["fake"]

# To use the real Ollama entry: uncomment it in the registry, set the host below,
# and switch the enabled backends to include ollama.
# OLLAMA_BASE_URL=http://<OLLAMA_HOST>:11434
# BROKER_ENABLED_BACKENDS=["fake","ollama"]
