# Request-queueing example — turn overload failures into bounded waits.
#
# Copy to .env (or export) and run the broker with this directory's registry:
#   BROKER_REGISTRY_PATH=examples/request-queueing/registry.yaml
#
# With the queue OFF (default) a request that can't be admitted blocks the
# concurrency semaphore unboundedly (or 429s with load_concurrency_policy=reject).
# With it ON, that request waits in a bounded, timed, fair queue and is served in
# turn — or rejected with a clear 429/503 + Retry-After once the limits are hit.

BROKER_AUTH_ENABLED=false
BROKER_REGISTRY_PATH=examples/request-queueing/registry.yaml

# Small concurrency so the queue is easy to observe on a laptop.
BROKER_MAX_CONCURRENT_REQUESTS=8
BROKER_PER_MODEL_MAX_CONCURRENCY=2

# --- The admission queue (ADR 0023) ---
BROKER_QUEUE_ENABLED=true
BROKER_QUEUE_MAX_DEPTH=64
BROKER_QUEUE_MAX_DEPTH_PER_MODEL=16
BROKER_QUEUE_MAX_WAIT_SECONDS=20
BROKER_QUEUE_RETRY_AFTER_SECONDS=5

# Concurrency + capacity triggers are on by default. Optionally also queue when
# the host is overloaded (1-min load average per CPU over the threshold):
# BROKER_QUEUE_TRIGGER_HOST=true
# BROKER_QUEUE_HOST_LOAD_PER_CPU_MAX=4.0

# With GPU telemetry on (ADR 0020), optionally queue on device-memory pressure:
# BROKER_GPU_TELEMETRY=nvidia
# BROKER_QUEUE_TRIGGER_DEVICE_MEMORY=true
# BROKER_QUEUE_DEVICE_FREE_MIB_MIN=2000
