# OpenTelemetry tracing — copy to .env (gitignored). Placeholders only.
BROKER_AUTH_ENABLED=true
BROKER_API_KEYS=["YOUR_API_KEY"]
BROKER_REGISTRY_PATH=examples/otel/registry.example.yaml
BROKER_ENABLED_BACKENDS=["fake"]

# Turn tracing on (requires the `otel` extra: pip install -e '.[otel]').
BROKER_TRACING_ENABLED=true
BROKER_TRACING_SERVICE_NAME=backend-agnostic-broker
# Spans carry metadata only. Opt in to prompt/response content capture explicitly:
# BROKER_TRACING_CAPTURE_CONTENT=true

# The OTLP exporter is configured via the standard OTEL_* env vars, not BROKER_*:
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
