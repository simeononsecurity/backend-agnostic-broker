# Web UI playground example (ADR 0015) — env for `broker`.
# Copy to `.env` in this directory and run `broker` from here, or export these.
# Keys are PLACEHOLDERS — replace YOUR_* before use. Never commit a filled-in .env.

# Turn the hardened static playground on (default is off).
BROKER_UI_ENABLED=true

# Offline fake backend + the registry in this folder.
BROKER_ENABLED_BACKENDS=["fake"]
BROKER_REGISTRY_PATH=registry.yaml

# Auth on with a demo data-plane key (paste this into the UI's "API key" field).
BROKER_AUTH_ENABLED=true
BROKER_API_KEYS=["YOUR_API_KEY"]

# Optional: enable the admin control plane so the UI's Admin tab works. Paste the
# admin key into the UI's "Admin key" field. Leave admin off to hide that tab.
BROKER_ADMIN_ENABLED=true
BROKER_ADMIN_API_KEYS=["YOUR_ADMIN_KEY"]

# Bind locally for a laptop demo.
BROKER_HOST=127.0.0.1
BROKER_PORT=8080

# Keep everything ephemeral for the demo.
BROKER_USAGE_LOG_PATH=:memory:
