# ADR 0020 + 0022 demo. Telemetry measures host RAM (swap to nvidia/amd on a GPU).
BROKER_GPU_TELEMETRY=host
BROKER_GPU_TELEMETRY_POLL_SECONDS=2.0
BROKER_RELEASE_TIMEOUT_SECONDS=15.0
# Declared budget used when telemetry can't measure a device: two 600 MiB models
# exceed 1000, so loading the second evicts the first.
BROKER_GPU_MEMORY_BUDGET_MIB=1000
BROKER_GPU_MEMORY_HEADROOM_MIB=512
# Count limit is out of the way so the demo shows the MEMORY limit, not the count.
BROKER_MAX_LOADED_MODELS=5
BROKER_AUTH_ENABLED=false
