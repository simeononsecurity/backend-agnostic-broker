# ADR 0017 reliability-v2 demo — tuned retries / cooldowns / ejection.
# Copy to .env (gitignored) next to registry.yaml. No secrets or host details.

BROKER_AUTH_ENABLED=false
BROKER_REGISTRY_PATH=./examples/reliability/registry.yaml
BROKER_ENABLED_BACKENDS=["fake"]
BROKER_HEALTH_PROBE_ENABLED=false

# --- Retries + full-jitter backoff (ADR 0009) ---
BROKER_RETRY_MAX_ATTEMPTS=4
BROKER_RETRY_BACKOFF_BASE_MS=50
BROKER_RETRY_BACKOFF_MAX_MS=2000

# --- Member cooldowns / circuit breaker (ADR 0009) ---
BROKER_COOLDOWN_FAILURES=2
BROKER_COOLDOWN_SECONDS=15

# --- Ejection cap + exponential growth (ADR 0017) ---
# Never bench more than 50% of the pool at once (keep >=2 of 3 serving).
BROKER_MAX_EJECTION_PERCENT=50
# Each repeated ejection doubles the window (15s -> 30s -> 60s), capped at 120s.
BROKER_COOLDOWN_BACKOFF_MULTIPLIER=2.0
BROKER_COOLDOWN_MAX_SECONDS=120
# Reset the multiplier after 300s of sustained success.
BROKER_COOLDOWN_DECAY_SECONDS=300

# --- Single-trial half-open probe (ADR 0017) ---
BROKER_COOLDOWN_HALF_OPEN_SINGLE_TRIAL=true

# --- Per-error retry / cooldown policy (ADR 0017) ---
# Opt a 429 into retry+cooldown and honor its Retry-After; 4xx is never retried.
BROKER_RETRY_ON_BACKPRESSURE=true
BROKER_COOLDOWN_ON_BACKPRESSURE=true
BROKER_RETRY_RESPECT_RETRY_AFTER=true
# Cap timeouts at 2 attempts even though the global budget is 4.
BROKER_RETRY_MAX_ATTEMPTS_BY_CLASS={"timeout": 2}

# --- Optional: shared state + global sticky LRU bound across replicas ---
# BROKER_REDIS_URL=redis://<REDIS_HOST>:6379/0
# BROKER_REDIS_STICKY_MAX_ENTRIES=100000
