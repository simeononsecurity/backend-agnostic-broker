# Redis multi-replica — copy to .env (gitignored). Placeholders only.
BROKER_AUTH_ENABLED=true
BROKER_API_KEYS=["YOUR_API_KEY"]
BROKER_REGISTRY_PATH=examples/docker-compose-redis/registry.example.yaml
BROKER_ENABLED_BACKENDS=["fake"]

# Shared state across replicas. In Compose the host is the service name `redis`.
BROKER_REDIS_URL=redis://redis:6379/0
BROKER_REDIS_PREFIX=broker
BROKER_REDIS_STICKY_MAX_ENTRIES=100000
