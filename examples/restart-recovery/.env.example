# Restart & recovery (ADR 0021). Copy to .env or export; see configuration.md.

# Startup action for runtimes recorded in the ledger after an unclean exit:
#   off | report (default) | adopt | stop
BROKER_RUNTIME_RECONCILE=adopt

# Fail fast if the runtime's target port is already bound (e.g. an orphan still
# holds it) instead of a confusing readiness timeout. Non-loading connect probe.
BROKER_RUNTIME_PORT_PRECHECK=true

# The ledger lives under the cache dir as <cache_dir>/runtime-ledger.json.
BROKER_CACHE_DIR=/var/cache/broker
