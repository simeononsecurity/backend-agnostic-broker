# backend-agnostic-broker configuration (env prefix: BROKER_)
# Copy to .env and edit. NEVER commit a filled-in .env with real secrets.

# --- Server ---
BROKER_HOST=0.0.0.0
BROKER_PORT=8080
BROKER_LOG_LEVEL=INFO
BROKER_LOG_FORMAT=json

# --- Auth (REQUIRED unless disabled) ---
BROKER_AUTH_ENABLED=true
# Comma/JSON list of accepted API keys. Provide via secret in production.
BROKER_API_KEYS=["change-me-local-key"]

# --- Per-key governance: virtual keys, rpm/tpm, budgets (ADR 0008) ---
# OPT-IN. With no keys file and no per-key limits, behavior is identical to
# v0.4.0. Point this at a git-ignored keys.yaml holding HASHED virtual keys
# (manage with `python -m broker.keys create|list|revoke`; see keys.example.yaml).
# Legacy BROKER_API_KEYS above keep working as UNLIMITED user keys. Per-key rpm
# (sliding window) and tpm (windowed counter) use this window length, in seconds.
# BROKER_KEYS_PATH=keys.yaml
BROKER_RATE_LIMIT_WINDOW_SECONDS=60

# --- Registry / models ---
BROKER_REGISTRY_PATH=registry.yaml
BROKER_DEFAULT_MODEL=
BROKER_ENABLED_BACKENDS=["fake","ollama","vllm","llamacpp","strata"]

# --- Backend endpoints (referenced by registry.yaml via ${VAR} expansion) ---
# Keep real host IPs/URLs OUT of the committed registry: reference them as
# ${OLLAMA_BASE_URL} in registry.yaml and set the real value here (or export it
# / inject via Docker secret). Example points at a local daemon; a remote (e.g.
# tailscale) daemon is just a different URL — the IP never enters git.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Lifecycle / concurrency ---
BROKER_MODEL_IDLE_TIMEOUT_SECONDS=300
BROKER_MAX_LOADED_MODELS=3
BROKER_MAX_CONCURRENT_REQUESTS=32
BROKER_PER_MODEL_MAX_CONCURRENCY=4
BROKER_REQUEST_TIMEOUT_SECONDS=300
BROKER_STARTUP_TIMEOUT_SECONDS=120
BROKER_SHUTDOWN_TIMEOUT_SECONDS=30
BROKER_IDLE_SWEEP_INTERVAL_SECONDS=5
BROKER_LOAD_CONCURRENCY_POLICY=queue

# --- Routing (load balancing across pool members) ---
# How requests are spread across the members of a pool (entries sharing a `pool`
# name in the registry).
#   sticky (default): pin each session to one member; only switch members if that
#     member is unhealthy/unavailable. Session = X-Session-Id header, else the
#     OpenAI `user` field in the body, else the client IP. New sessions are given
#     the least-busy member, so distinct sessions still spread across the pool.
#   least_busy: route every request to the member with the fewest in-flight.
#   round_robin: rotate members every request.
#   cache_aware: prefix-affinity + load-aware scoring (ADR 0010); opt-in (below).
# Failover across members is automatic on backend errors (and re-pins under sticky).
BROKER_ROUTE_STRATEGY=sticky
# Max remembered session->member pairings (LRU-evicted). Bounds sticky memory.
BROKER_ROUTE_STICKY_MAX_ENTRIES=10000

# --- Cache-aware pool routing (ADR 0010; only when ROUTE_STRATEGY=cache_aware) ---
# Routes each request to the pool member that already holds its prompt prefix
# (warm KV cache), scoring score = matched_fraction - beta*relative_load and
# falling back to least_busy when no member holds any prefix. No effect unless
# cache_aware is selected; all defaults keep v0.4.0 behavior.
# cache_aware tunables (ADR 0010; only active when route_strategy=cache_aware):
#   beta: load-penalty weight. 0 = pure prefix affinity; higher spreads harder.
#   Default 0.25 chosen from the scripts/bench_routing.py scenario x beta matrix
#   (smallest beta that stays balanced under low pressure while ~doubling hit rate
#   under cache pressure; beta=1.0 made the load term swamp affinity).
BROKER_CACHE_AWARE_BETA=0.25
#   block_chars: characters per chained prefix block (~4 chars/token).
BROKER_CACHE_AWARE_BLOCK_CHARS=128
#   max_entries: prefix-index LRU bound per replica (0 = unbounded; TTL applies).
BROKER_CACHE_AWARE_MAX_ENTRIES=10000
#   ttl_seconds: prefix-index entry TTL, approximating KV-cache residency (0 = none).
BROKER_CACHE_AWARE_TTL_SECONDS=1800
#   use_metrics: scrape vLLM /metrics (num_requests_waiting) via the NON-LOADING
#   health probe for a real load signal; falls back to in-flight counts.
BROKER_CACHE_AWARE_USE_METRICS=false

# --- Retries & backoff (ADR 0009) ---
# Transparent retry of a failed request WITHIN the requested model's pool (never
# a different model). Defaults below reproduce v0.4.0 EXACTLY: one failover pass
# over the pool members with NO sleep.
#   RETRY_MAX_ATTEMPTS: 0 = legacy (one attempt per pool member). A positive
#     value caps total attempts and enables re-trying members after a backoff
#     delay (useful for single-member pools / transient failures).
#   backoff: full-jitter capped exponential (AWS pattern):
#     delay = uniform(0, min(MAX_MS, BASE_MS * 2**attempt)). BASE_MS=0 = no sleep.
# Retrying respects BROKER_REQUEST_TIMEOUT_SECONDS as an overall deadline.
BROKER_RETRY_MAX_ATTEMPTS=0
BROKER_RETRY_BACKOFF_BASE_MS=0
BROKER_RETRY_BACKOFF_MAX_MS=2000

# --- Member cooldowns / circuit breaker (ADR 0009) ---
# After COOLDOWN_FAILURES consecutive failures a pool member is benched for
# COOLDOWN_SECONDS; selection skips benched members; once the window elapses the
# member is eligible again as a half-open trial (success resets, failure
# re-benches). Visible in GET /status and GET /healthz/backends.
# Default-off (0) preserves v0.4.0 behavior.
BROKER_COOLDOWN_FAILURES=0
BROKER_COOLDOWN_SECONDS=30

# --- Optional shared state via Redis (ADR 0009, multi-replica) ---
# Unset by default => in-process state (exactly today's behavior, no new dep).
# Set a URL to share the sticky map, cooldowns, counters, and cached values
# across broker replicas behind a load balancer. Requires the optional extra:
#   pip install 'backend-agnostic-broker[redis]'
# If BROKER_REDIS_URL is set but 'redis' is not installed the broker fails fast.
# BROKER_REDIS_URL=redis://127.0.0.1:6379/0
BROKER_REDIS_PREFIX=broker
# TTL (seconds) for Redis sticky keys (0 = no expiry; in-process uses LRU instead).
BROKER_ROUTE_STICKY_TTL_SECONDS=0

# --- Background health probing (non-loading) ---
# Periodically liveness-probe active models WITHOUT loading any: Ollama via
# GET /api/tags, broker-managed runtimes only while their process is running.
# A READY model whose backend has gone away is marked failed so the next request
# reloads/reroutes. Surfaced live at GET /healthz/backends and in GET /status.
BROKER_HEALTH_PROBE_ENABLED=true
BROKER_HEALTH_PROBE_INTERVAL_SECONDS=30
BROKER_HEALTH_PROBE_TIMEOUT_SECONDS=5

# --- Auto-router ("auto" alias) ---
# Send {"model":"auto",...} and a tiny classifier picks the best real model for
# the request from the live registry. Only "auto" is affected. Backend:
#   auto      : use the llama.cpp GGUF classifier if available, else heuristic
#   heuristic : zero-dependency rule/score router (no model needed)
#   llm       : force the GGUF classifier (errors if unavailable)
#   off       : disable the "auto" alias
BROKER_ROUTER_ENABLED=true            # expose the "auto" alias at all
BROKER_ROUTER_ALIAS=auto              # the virtual model id that triggers routing
BROKER_ROUTER_BACKEND=auto            # auto | heuristic | llm | off (see above)
# GGUF for the LLM classifier (the container sets this to the bundled model when
# built with --build-arg WITH_ROUTER_LLM=1).
# BROKER_ROUTER_MODEL_PATH=/models/router.gguf
BROKER_ROUTER_MODEL_CTX=2048          # classifier context window (tokens)
# BROKER_ROUTER_THREADS=4             # CPU threads for the classifier (unset = auto)
BROKER_ROUTER_MAX_INPUT_CHARS=2048    # truncate the last user message to ~this many chars
BROKER_ROUTER_CACHE_SIZE=512          # LRU size of the decision cache
BROKER_ROUTER_TIMEOUT_SECONDS=10      # per-classification timeout before the fallback
# Deterministic fallback model id (overrides registry router.default).
# BROKER_ROUTER_DEFAULT_MODEL=

# --- Auto-router: latency-budget routing (opt-in; ADR 0011) ---
# Choose a faster capable model when the pick's estimated latency (usage-log p90
# + a cold-start penalty) would exceed the budget. Precedence: the
# x-broker-latency-budget-ms request header, then registry router.latency_budget_ms,
# then this. Unset = no budget (default behavior unchanged).
# BROKER_ROUTER_LATENCY_BUDGET_MS=2000
BROKER_ROUTER_LATENCY_WINDOW_SECONDS=3600   # usage-log window for the latency estimate
BROKER_ROUTER_COLD_START_MS=1500            # penalty added for a not-yet-resident model

# --- Placement / data-residency pinning (opt-in, FAIL-CLOSED; ADR 0011) ---
# Per-model `placement` labels live in registry.yaml. A request requirement comes
# from the x-broker-placement header (set server-side) unioned with this baseline.
# Only models carrying ALL required labels are eligible (auto, explicit, and pool
# members); if none qualify the broker returns 403 placement_denied and never
# spills to a non-compliant model. Empty = no baseline requirement.
BROKER_DEFAULT_PLACEMENT=[]

# --- Limits ---
BROKER_MAX_REQUEST_BYTES=2000000

# --- Response cache (ADR 0012; default OFF) ---
# Exact-match cache: identical requests to the same model/key scope are served
# from the StateStore (in-process, or Redis when BROKER_REDIS_URL is set) instead
# of re-running inference. The key hashes (API-key/tenant scope, public model
# AFTER auto resolution, normalized messages/prompt/input + sampling + tools +
# response_format), so a cached answer never crosses a key/tenant boundary.
# Errors/partials are never cached; streaming bypasses. Bypass per request via
# `Cache-Control: no-cache` / `x-broker-cache: bypass`; responses carry
# `x-broker-cache: hit|miss|bypass`.
BROKER_RESPONSE_CACHE_ENABLED=false
BROKER_RESPONSE_CACHE_TTL_SECONDS=300       # 0 = no TTL (rely on max_entries)
BROKER_RESPONSE_CACHE_MAX_ENTRIES=1000      # in-process LRU bound (0 = unbounded)
BROKER_RESPONSE_CACHE_MAX_BYTES=1000000     # per-entry cap; larger results not stored (0 = no cap)
BROKER_RESPONSE_CACHE_DETERMINISTIC_ONLY=true  # cache only temperature==0 / seeded requests

# --- Admin runtime control (ADR 0012; default OFF) ---
# Privileged control plane: GET /admin/models, model unload/load, registry
# hot-reload. Gated by a DEDICATED admin-key list (not BROKER_API_KEYS) so the
# control plane is isolated from the data plane.
BROKER_ADMIN_ENABLED=false
BROKER_ADMIN_API_KEYS=[]                     # e.g. ["YOUR_ADMIN_KEY"]; required when admin is enabled + auth on
BROKER_ADMIN_DRAIN_TIMEOUT_SECONDS=30        # how long unload/reload waits for in-flight to drain

# --- Web UI / playground (ADR 0012) --- DEFERRED; flag reserved, currently inert.
BROKER_UI_ENABLED=false

# --- Security allow-lists ---
BROKER_ALLOWED_EXEC_DIRS=["/usr/bin","/usr/local/bin","/opt"]
BROKER_ALLOWED_MODEL_ROOTS=["/models"]
BROKER_EXTRA_ALLOWED_BACKEND_URLS=[]
BROKER_ALLOW_LOOPBACK_BACKENDS=true

# --- GPU ---
BROKER_GPU_VISIBLE=false
# BROKER_CUDA_VISIBLE_DEVICES=0,1

# --- Cache / tmp ---
BROKER_CACHE_DIR=/var/cache/broker
BROKER_TMP_DIR=/tmp/broker

# --- Observability ---
BROKER_METRICS_ENABLED=true
# OpenTelemetry tracing (ADR 0012; default OFF, zero overhead when off). Requires
# the optional `otel` extra: pip install 'backend-agnostic-broker[otel]'. Spans
# carry gen_ai.* metadata only — NEVER prompt/response content. Configure the
# OTLP exporter with the standard OTEL_* env vars, e.g.:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#   OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
BROKER_TRACING_ENABLED=false
BROKER_TRACING_SERVICE_NAME=backend-agnostic-broker
# Per-request usage log (metadata + token counts only; exposed at GET /usage).
BROKER_USAGE_LOG_ENABLED=true          # record usage to SQLite
# BROKER_USAGE_LOG_PATH=/var/cache/broker/usage.sqlite3   # default; ":memory:" for ephemeral

# --- Docker networking hint ---
BROKER_DOCKER_NETWORK_MODE=bridge
