# backend-agnostic-broker configuration (env prefix: BROKER_)
# Copy to .env and edit. NEVER commit a filled-in .env with real secrets.

# --- Server ---
BROKER_HOST=0.0.0.0
BROKER_PORT=8080
BROKER_LOG_LEVEL=INFO
BROKER_LOG_FORMAT=json

# --- Auth (REQUIRED unless disabled) ---
BROKER_AUTH_ENABLED=true
# Comma/JSON list of accepted API keys. Provide via secret in production.
BROKER_API_KEYS=["change-me-local-key"]

# --- Registry / models ---
BROKER_REGISTRY_PATH=registry.yaml
BROKER_DEFAULT_MODEL=
BROKER_ENABLED_BACKENDS=["fake","ollama","vllm","llamacpp","strata"]

# --- Lifecycle / concurrency ---
BROKER_MODEL_IDLE_TIMEOUT_SECONDS=300
BROKER_MAX_LOADED_MODELS=3
BROKER_MAX_CONCURRENT_REQUESTS=32
BROKER_PER_MODEL_MAX_CONCURRENCY=4
BROKER_REQUEST_TIMEOUT_SECONDS=300
BROKER_STARTUP_TIMEOUT_SECONDS=120
BROKER_SHUTDOWN_TIMEOUT_SECONDS=30
BROKER_IDLE_SWEEP_INTERVAL_SECONDS=5
BROKER_LOAD_CONCURRENCY_POLICY=queue

# --- Limits ---
BROKER_MAX_REQUEST_BYTES=2000000

# --- Security allow-lists ---
BROKER_ALLOWED_EXEC_DIRS=["/usr/bin","/usr/local/bin","/opt"]
BROKER_ALLOWED_MODEL_ROOTS=["/models"]
BROKER_EXTRA_ALLOWED_BACKEND_URLS=[]
BROKER_ALLOW_LOOPBACK_BACKENDS=true

# --- GPU ---
BROKER_GPU_VISIBLE=false
# BROKER_CUDA_VISIBLE_DEVICES=0,1

# --- Cache / tmp ---
BROKER_CACHE_DIR=/var/cache/broker
BROKER_TMP_DIR=/tmp/broker

# --- Observability ---
BROKER_METRICS_ENABLED=true
BROKER_TRACING_ENABLED=false

# --- Docker networking hint ---
BROKER_DOCKER_NETWORK_MODE=bridge
